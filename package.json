{
    "name": "notion-boost-browser-extension",
    "description": "Notion Boost - add outline and more to Notion",
    "private": false,
    "version": "1.0.0",
    "type": "module",
    "scripts": {
        "dev": "wxt",
        "dev:firefox": "wxt -b firefox --mv2",
        "build": "wxt build",
        "compile": "tsc --noEmit",
        "postinstall": "wxt prepare",
        "check-updates": "ncu -i --format repo,group",
        "lint": "eslint .",
        "package-chrome": "wxt zip",
        "package-firefox": "wxt zip -b firefox",
        "package": "pnpm run package-chrome && pnpm run package-firefox",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "wxt build && playwright test",
        "test:e2e:login": "node e2e/save-login.mjs"
    },
    "dependencies": {
        "react": "^19.3.1",
        "react-dom": "^19.3.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@playwright/test": "1.64.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "@wxt-dev/module-react": "^1.2.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-prettier": "^5.5.7",
        "eslint-plugin-promise": "^7.3.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "happy-dom": "^21.0.4",
        "prettier": "^3.9.10",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "sass": "1.106.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5",
        "vitest": "5.0.5",
        "wxt": "^0.21.4"
    }
}
